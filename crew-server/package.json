    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/mcp": "^0.0.80",
    "@slack/bolt": "^5.1.0",
    "qrcode-generator": "^2.0.4",
    "ssh2": "^1.17.0",
    "typebox": "1.3.7",
    "ws": "8.18.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
