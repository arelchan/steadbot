    "serve": "sh scripts/run.sh",
    "cloud": "tsx src/cloud/index.ts"
  },
  "dependencies": {
    "@composio/core": "^0.18.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
