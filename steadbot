#!/usr/bin/env bash
# Steadbot · one command, on your own computer
#
#   steadbot            # start the server + the App and open a browser (already up: just open it)
#   steadbot stop       # stop both
#   steadbot status     # what is running
#   steadbot logs      # follow the server log
#
# First time, put the command on your PATH (run once from the repo root): bash steadbot install
#
# Optional env: STEADBOT_PORT (server, default 5200), STEADBOT_APP_PORT (App, default 5199),
#              STEADBOT_NO_BROWSER=1 (do not open a browser), CREW_HOME (data dir, default ~/.crew)
set -euo pipefail

# Resolve through symlinks: `steadbot` is normally invoked via a link on PATH, and the repo is where the
# real file lives, not where the link sits.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  link_dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$link_dir/$src" ;; esac
done
root="$(cd -P "$(dirname "$src")" && pwd)"
server="$root/crew-server"
app="$root/bot-crew"
home="${CREW_HOME:-$HOME/.crew}"
port="${STEADBOT_PORT:-5200}"
app_port="${STEADBOT_APP_PORT:-5199}"
run="$home/run"
logs="$home/logs"
mkdir -p "$run" "$logs"

say() { printf '\033[1m▸ %s\033[0m\n' "$*"; }
ok() { printf '\033[32m✔ %s\033[0m\n' "$*"; }
warn() { printf '\033[33m! %s\033[0m\n' "$*"; }
die() { printf '\033[31m✘ %s\033[0m\n' "$*" >&2; exit 1; }

healthy() { curl -fsS -m 2 "http://127.0.0.1:$port/health" >/dev/null 2>&1; }
# Vite binds to localhost, which on recent Node resolves to ::1 first — so probe by name, not 127.0.0.1.
app_up() { curl -fsS -m 3 -o /dev/null "http://localhost:$app_port/" 2>/dev/null; }

# Kill a recorded pid and everything under it (run.sh → tsx → node; npm → vite).
kill_tree() {
  local pid="$1"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null || return 0
  local kids
  kids="$(pgrep -P "$pid" 2>/dev/null || true)"
  for k in $kids; do kill_tree "$k"; done
  kill "$pid" 2>/dev/null || true
}

do_stop() {
  local any=0
  for name in server app; do
    local f="$run/$name.pid"
    if [ -f "$f" ]; then
      local pid; pid="$(cat "$f")"
      if kill -0 "$pid" 2>/dev/null; then kill_tree "$pid"; any=1; fi
      rm -f "$f"
    fi
  done
  # Anything this script's own paths left behind (a stale pid file, a crash).
  pkill -f "$server/node_modules/.bin/tsx src/index.ts" 2>/dev/null && any=1 || true
  pkill -f "vite --port $app_port --strictPort" 2>/dev/null && any=1 || true
  [ "$any" = 1 ] && ok "stopped" || say "nothing was running"
}

do_status() {
  if healthy; then ok "server  up    http://127.0.0.1:$port  (data in ${home})"; else warn "server  down"; fi
  if app_up; then ok "App     up    http://localhost:$app_port"; else warn "App     down"; fi
  local mode
  mode="$(curl -fsS -m 2 "http://127.0.0.1:$port/runtime/info" 2>/dev/null | sed -n 's/.*"mode":"\([a-z]*\)".*/\1/p' || true)"
  case "$mode" in
    moved) warn "note: the bots moved to another machine; this is only a signpost (the App follows automatically — Settings › Cloud computer has the way back)" ;;
    standby) warn "note: another machine is running this home; this one is on standby" ;;
  esac
}

do_logs() { exec tail -n 80 -f "$logs/server.log"; }

# Put `steadbot` on PATH so it works from any directory. A symlink, so it follows the repo.
do_install() {
  local target="" d
  for d in "$HOME/.local/bin" "/opt/homebrew/bin" "/usr/local/bin"; do
    if [ -d "$d" ] && [ -w "$d" ]; then
      case ":$PATH:" in *":$d:"*) target="$d"; break ;; esac
    fi
  done
  if [ -z "$target" ]; then
    target="$HOME/.local/bin"
    mkdir -p "$target"
    warn "$target is not on your PATH yet. Add this line to ~/.zshrc, then open a new terminal:"
    printf '   export PATH="$HOME/.local/bin:$PATH"\n'
  fi
  ln -sf "$root/steadbot" "$target/steadbot"
  ok "installed: $target/steadbot — from now on just type steadbot, anywhere"
}

need_node() {
  command -v node >/dev/null 2>&1 || die "needs Node.js 22 or newer: https://nodejs.org/ — install it and try again"
  local major; major="$(node -p 'process.versions.node.split(".")[0]')"
  [ "$major" -ge 22 ] 2>/dev/null || die "Node.js is too old ($(node -v)); 22 or newer is required"
}

need_deps() {
  for d in "$server" "$app"; do
    if [ ! -d "$d/node_modules" ]; then
      say "first run, installing dependencies: $(basename "$d") (a minute or two)"
      (cd "$d" && (npm ci --silent 2>/dev/null || npm install --silent))
    fi
  done
}

check_config() {
  local cfg="$home/config.json"
  if [ ! -f "$cfg" ] || ! grep -q '"keys"' "$cfg" 2>/dev/null; then
    warn "no model key yet: a bot needs a model to do anything."
    cat <<TIP
   Put this in $cfg (mode 600, never commit it):
   {
     "model": "openrouter/deepseek/deepseek-v4-flash",
     "keys": { "OPENROUTER_API_KEY": "sk-or-..." }
   }
   Starting without one is fine — you get the UI; add a key and run bash steadbot again.
TIP
  fi
}

do_start() {
  need_node
  need_deps
  check_config

  if healthy; then
    ok "server already up (${port})"
  else
    say "starting the server… (first run takes ~30s: it syncs the skill library)"
    ( cd "$server" && CREW_PORT="$port" nohup sh scripts/run.sh >>"$logs/server.log" 2>&1 & echo $! >"$run/server.pid" )
    local i
    for i in $(seq 1 120); do healthy && break; sleep 1; done
    healthy || { tail -n 20 "$logs/server.log"; die "the server did not come up; see above (full log: $logs/server.log)"; }
    ok "server http://127.0.0.1:$port"
  fi

  if app_up; then
    ok "App already up (${app_port})"
  else
    say "starting the App…"
    ( cd "$app" && VITE_CREW_WS="ws://localhost:$port/ws" nohup npx vite --port "$app_port" --strictPort >>"$logs/app.log" 2>&1 & echo $! >"$run/app.pid" )
    # Vite answers only after its first dependency pre-bundle, which can take a minute on a cold cache.
    local i
    for i in $(seq 1 180); do app_up && break; sleep 0.5; done
    app_up || { tail -n 20 "$logs/app.log"; die "the App did not come up; see above (full log: ${logs}/app.log)"; }
    ok "App http://localhost:$app_port"
  fi

  do_status | grep -E '^\S+ note' || true
  local url="http://localhost:$app_port"
  if [ "${STEADBOT_NO_BROWSER:-}" != 1 ]; then
    if command -v open >/dev/null 2>&1; then open "$url"; elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$url" >/dev/null 2>&1 || true; fi
  fi
  echo
  ok "Steadbot is up: $url"
  echo "   stop: steadbot stop    logs: steadbot logs"
}

case "${1:-start}" in
  start) do_start ;;
  stop) do_stop ;;
  restart) do_stop; do_start ;;
  status) do_status ;;
  logs) do_logs ;;
  install) do_install ;;
  *) echo "usage: steadbot [start|stop|restart|status|logs|install]"; exit 1 ;;
esac
